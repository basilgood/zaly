{
  "name": "@zaly/agent",
  "version": "0.0.5",
  "description": "Agent runtime, sessions, tools, permissions, compaction, and tasks for zaly.",
  "keywords": [
    "agent",
    "ai",
    "runtime",
    "sessions",
    "tools"
  ],
  "homepage": "https://github.com/folke/zaly/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/folke/zaly/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folke/zaly.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./session": {
      "bun": "./src/session/index.ts",
      "default": "./dist/session.mjs"
    },
    "./session/claude": {
      "bun": "./src/session/claude.ts",
      "default": "./dist/session/claude.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./session": "./dist/session.mjs",
      "./session/claude": "./dist/session/claude.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "z build",
    "lint": "z lint",
    "test": "z test"
  },
  "dependencies": {
    "@zaly/ai": "workspace:*",
    "@zaly/shared": "workspace:*",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "defuddle": "^0.19.2",
    "ignore": "^7.0.5",
    "jsonpath-plus": "^10.4.0",
    "linkedom": "^0.18.13",
    "shell-quote": "^1.9.0"
  },
  "peerDependencies": {
    "typebox": "^1.3.6"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.11"
  },
  "inlinedDependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@xmldom/xmldom": "0.9.12",
    "boolbase": "2.0.0",
    "css-select": "7.0.0",
    "css-what": "8.0.0",
    "cssom": "0.5.0",
    "defuddle": "0.19.3",
    "dom-serializer": [
      "2.0.0",
      "3.1.1"
    ],
    "domelementtype": [
      "2.3.0",
      "3.0.0"
    ],
    "domhandler": [
      "5.0.3",
      "6.0.1"
    ],
    "domutils": [
      "3.2.2",
      "4.0.2"
    ],
    "entities": [
      "4.5.0",
      "7.0.1",
      "8.0.0"
    ],
    "htmlparser2": "10.1.0",
    "ignore": "7.0.5",
    "jsonpath-plus": "10.4.0",
    "linkedom": "0.18.13",
    "mathml-to-latex": "1.8.0",
    "nth-check": "3.0.1",
    "shell-quote": "1.9.0",
    "temml": "0.13.5",
    "turndown": "7.2.4",
    "uhyphen": "0.2.0"
  }
}
